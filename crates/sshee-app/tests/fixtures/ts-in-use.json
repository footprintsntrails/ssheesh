            "id": "s-logs",
            "name": "Follow a container's log",
            "command": "docker logs -f --tail {{lines:100}} {{container}}"
          },
          {
            "id": "s-restart",
            "name": "Restart a service",
            "command": "sudo systemctl restart {{service}} && systemctl status --no-pager {{service}}"
