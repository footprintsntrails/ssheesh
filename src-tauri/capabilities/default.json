{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the SSHeesh window is allowed to do",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    "updater:default",
    "process:default",
    "opener:default",
    "notification:default",
    "clipboard-manager:allow-write-text",
    "core:webview:allow-set-webview-zoom"
  ]
}
